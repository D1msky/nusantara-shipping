# Keep development files out of the Composer dist archive
/.github            export-ignore
/.idea              export-ignore
/tests              export-ignore
/.gitattributes     export-ignore
/.gitignore         export-ignore
/phpunit.xml        export-ignore
/tools              export-ignore

# villages.php keeps its rows inside a multi-line string literal; a CRLF checkout would change the data
/data/*.php         text eol=lf
